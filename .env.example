# Register this exact callback URL in the Databricks custom OAuth integration.
# For local development, keep LakeLoom on the same port used in this URL.
DATABRICKS_OAUTH_CLIENT_ID=
DATABRICKS_OAUTH_CLIENT_SECRET=
LAKELOOM_PUBLIC_URL=http://127.0.0.1:8000
LAKELOOM_SECRET_KEY=replace-with-a-long-random-value
LAKELOOM_COOKIE_SECURE=false
# Local development keeps usernames and profile photos across restarts here.
# For Databricks Apps, point this to a writable persistent Volume path, for example:
# LAKELOOM_PROFILE_STORE=/Volumes/<catalog>/<schema>/<volume>/lakeloom/profiles.db
LAKELOOM_PROFILE_STORE=~/.lakeloom/profiles.db
